{
  "name": "hebrew-calendar-studio",
  "displayName": "Hebrew Calendar Studio",
  "displayNameHebrew": "סטודיו לוח עברי",
  "version": "1.0.0",
  "packagedAt": "2026-08-16",
  "entryPoint": "index.html",
  "runtime": "Static client-side HTML, CSS, and JavaScript",
  "externalDataSource": "https://www.hebcal.com/hebcal",
  "defaultLocale": "he-IL",
  "direction": "rtl",
  "supportedPaperSizes": ["A4 portrait", "A3 portrait"],
  "defaultPagination": "single-page auto-fit",
  "maximumRangeDays": 1096,
  "localStorageKeys": [
    "seder-yom-settings-v1",
    "seder-yom-notes-v1",
    "seder-yom-hebcal-cache-v1"
  ],
  "documentation": {
    "english": "docs/SPECIFICATION_EN.md",
    "hebrew": "docs/SPECIFICATION_HE.md"
  },
  "references": [
    "references/לוח חודשים_עריכה.pptx",
    "references/לוח חודשים_09.11.2023.pdf"
  ],
  "tests": [
    "tests/test_app.py",
    "tests/test_layout_extremes.py",
    "tests/diagnose_print_clipping.py"
  ]
}
